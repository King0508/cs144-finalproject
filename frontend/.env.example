# Public Firebase web config (safe to expose, but still kept out of git).
# Copy to .env.local and fill in from your Firebase project's Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM Web Push public VAPID key (Cloud Messaging > Web configuration).
VITE_FIREBASE_VAPID_KEY=

# Where the frontend should call the backend during local dev. The Vite dev
# server proxies /api to this URL.
VITE_BACKEND_URL=http://localhost:8080
