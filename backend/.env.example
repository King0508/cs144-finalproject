# --- Required ---

# GCP project hosting Firebase + Firestore + FCM.
FIREBASE_PROJECT_ID=

# Path to a service-account JSON file. In Kubernetes you'll mount this as a
# Secret and set GOOGLE_APPLICATION_CREDENTIALS to the mount path; outside
# GKE the Admin SDK also auto-loads it via GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini API key. Use a Gemini API key with the free tier (Gemini 2.5 Flash).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional ---

# Gemini model to use. Defaults to gemini-2.5-flash-lite, which has a separate
# free-tier quota bucket. Switch to gemini-2.5-flash for higher quality once
# billing raises the project's rate limits.
GEMINI_MODEL=gemini-2.5-flash-lite

# Where the backend listens.
PORT=8080

# Allowed CORS origin(s), comma-separated. Set this to your deployed domain in production.
CORS_ALLOW_ORIGIN=http://localhost:5173

# How often the scheduler pings (ms). Default 60s.
SCHEDULER_INTERVAL_MS=60000

# Reminder lead time before a study (minutes). Default 15.
REMINDER_LEAD_MINUTES=15

# Set to "true" to disable the scheduler (useful in dev / when running multiple replicas
# locally without coordination). In production this is left enabled.
DISABLE_SCHEDULER=false
